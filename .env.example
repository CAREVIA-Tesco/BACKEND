# Server
PORT=5000
NODE_ENV=development

# MongoDB - local MongoDB Community Server or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/carevia

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Default super admin (created by "npm run seed" and on first start)
ADMIN_EMAIL=admin@carevia.com
ADMIN_PASSWORD=Admin@123

# PIN code lookup (city / district / state from a 6-digit Indian PIN). Optional – these are the defaults.
# PINCODE_API_URL=https://api.postalpincode.in/pincode/
# PINCODE_FALLBACK_URL=https://api.zippopotam.us/in/

# Forgot password by SMS OTP (Twilio). Set these on Render → Environment, never in git.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Either a Verify service (recommended) ...
# TWILIO_VERIFY_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ... or a Twilio phone number to send the OTP from
# TWILIO_FROM=+1xxxxxxxxxx
