# Server
PORT=5000
NODE_ENV=development

# MongoDB - local MongoDB Community Server or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/carevia

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Default super admin (created by "npm run seed" and on first start)
ADMIN_EMAIL=admin@carevia.com
ADMIN_PASSWORD=Admin@123

# true = doctors appear to patients right after onboarding; false = admin must approve them first
PROVIDER_AUTO_APPROVE=true

# DNS used to look up "mongodb+srv://" Atlas addresses (fixes "querySrv ECONNREFUSED" on Windows).
# Use "system" to keep your PC's own DNS.
DNS_SERVERS=8.8.8.8,1.1.1.1
